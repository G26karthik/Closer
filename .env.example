# Closer — environment variables
# Copy to .env and fill in values before running locally.
# Do NOT commit .env to version control.
#
# Required — the app will refuse to start without these:
GEMINI_API_KEY=your-gemini-api-key-here
FIRESTORE_PROJECT_ID=your-gcp-project-id

# Optional — needed for frontend OAuth and Firebase realtime updates:
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
GOOGLE_CLIENT_ID=your-oauth-client-id
GOOGLE_CLIENT_SECRET=your-oauth-client-secret
#
# Frontend Google Sign-In OAuth scopes required by the rebuilt agentic system:
#   Existing scopes (pre-rebuild):
#     - https://www.googleapis.com/auth/calendar.events (calendar event creation/read)
#     - https://www.googleapis.com/auth/gmail.compose (email draft composition)
#   New scopes (Task 4 & stretch Task 9):
#     - https://www.googleapis.com/auth/calendar.freebusy (freebusy-aware scheduling)
#     - https://www.googleapis.com/auth/documents (Google Docs artifact generation, DocumentAgent)
# Request these scopes in the frontend's gapi.auth2.init() call.
CLOUD_RUN_SERVICE_URL=https://closer-xxxx-uc.a.run.app

# Server port (defaults to 8080):
PORT=8080

# Set to "local" for human-readable log output, omit for JSON (production):
ENVIRONMENT=local
